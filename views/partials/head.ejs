<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 900px; margin: 2rem auto; padding: 0 1rem; color: #1a1a1a; }
  header { border-bottom: 1px solid #ccc; padding-bottom: 1rem; margin-bottom: 1.5rem; }
  h1 { margin: 0 0 .25rem; }
  code { background: #f2f2f2; padding: .1rem .3rem; border-radius: 3px; }
  .vuln { margin: .5rem 0; }

  .toggles { display: flex; flex-wrap: wrap; gap: 1.5rem; margin: 1rem 0 .5rem; }
  .toggle { display: flex; align-items: center; gap: .6rem; margin: 0; }
  .toggle-label { font-weight: 600; }
  
  .switch { position: relative; display: inline-block; width: 46px; height: 24px; }
  .switch input { opacity: 0; width: 0; height: 0; }
  .slider { position: absolute; cursor: pointer; inset: 0; background: #bbb; border-radius: 24px; transition: .2s; }
  .slider::before { content: ""; position: absolute; height: 18px; width: 18px; left: 3px; bottom: 3px;
    background: #fff; border-radius: 50%; transition: .2s; }
  .switch input:checked + .slider { background: #c0392b; }
  .switch input:checked + .slider::before { transform: translateX(22px); }

  .badge { font-size: .75rem; font-weight: 700; letter-spacing: .03em; padding: .15rem .5rem; border-radius: 4px; }
  .badge-vuln { background: #fdecea; color: #c0392b; border: 1px solid #c0392b; }
  .badge-secure { background: #eafaf1; color: #1e8449; border: 1px solid #1e8449; }

  .mainnav { margin-top: .75rem; }
  .mainnav a { margin-right: 1rem; }
</style>
