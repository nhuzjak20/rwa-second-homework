<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<style>
  body { font-family: Georgia, 'Times New Roman', serif; max-width: 820px; margin: 2rem auto;
    padding: 0 1rem; color: #000; background: #fff; line-height: 1.5; }
  header { border-bottom: 1px solid #000; padding-bottom: 1rem; margin-bottom: 1.5rem; }
  h1 { margin: 0 0 .25rem; font-size: 1.4rem; }
  h2 { font-size: 1.1rem; margin: 0 0 .5rem; }
  h3 { font-size: .95rem; margin: .8rem 0 .3rem; }
  code { font-family: Consolas, monospace; }

  .toggles { display: flex; flex-direction: column; gap: .4rem; margin: 1rem 0 .5rem; }
  .toggle { display: flex; align-items: center; gap: .5rem; margin: 0; }
  .toggle input[type="checkbox"] { width: 16px; height: 16px; }
  .toggle-label { min-width: 170px; }
  .badge { font-family: Consolas, monospace; font-weight: 700; }

  .panel { border: 1px solid #000; padding: 1rem; margin: 1rem 0; }
  form.inline { display: flex; gap: .5rem; flex-wrap: wrap; align-items: flex-end; margin: .5rem 0; }
  label.field { display: flex; flex-direction: column; font-size: .85rem; gap: .2rem; }
  input[type="text"], input[type="password"] { padding: .3rem; border: 1px solid #000;
    min-width: 220px; font-family: Consolas, monospace; }
  button { padding: .4rem .9rem; border: 1px solid #000; background: #fff; color: #000;
    cursor: pointer; font-family: inherit; }
  button:hover { background: #000; color: #fff; }

  pre.sql { border: 1px solid #000; padding: .6rem; overflow-x: auto; white-space: pre-wrap;
    font-family: Consolas, monospace; font-size: .85rem; background: #fff; }
  table { border-collapse: collapse; width: 100%; margin-top: .5rem; }
  th, td { border: 1px solid #000; padding: .3rem .5rem; text-align: left; font-size: .9rem; }
  th { background: #fff; font-weight: 700; }

  .ok, .fail, .err { font-weight: 700; }
  .err { font-family: Consolas, monospace; font-weight: 400; }
  .hint { font-size: .85rem; }
  .leak td { font-weight: 700; }
  nav.mainnav { margin-top: .75rem; }
  nav.mainnav a { margin-right: 1rem; }
</style>
