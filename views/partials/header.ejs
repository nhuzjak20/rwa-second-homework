<header>
  <h1>RWA — Security Vulnerabilities Demo</h1>
  <p>SQL Injection &amp; Broken Authentication, each with a VULNERABLE/SECURE toggle.</p>

  <div class="toggles">
    <%
      const switches = [
        { name: 'sqli', label: 'SQL Injection', on: flags.sqliVulnerable },
        { name: 'auth', label: 'Broken Authentication', on: flags.authVulnerable },
      ];
    %>
    <% switches.forEach(function (s) { %>
      <form class="toggle" method="POST" action="/toggle">
        <input type="hidden" name="name" value="<%= s.name %>">
        <span class="toggle-label"><%= s.label %></span>
        <label class="switch">
          <input type="checkbox" onchange="this.form.submit()" <%= s.on ? 'checked' : '' %>>
          <span class="slider"></span>
        </label>
        <span class="badge <%= s.on ? 'badge-vuln' : 'badge-secure' %>">
          <%= s.on ? 'VULNERABLE' : 'SECURE' %>
        </span>
      </form>
    <% }); %>
  </div>

  <nav class="mainnav">
    <a href="/">Home</a>
  </nav>
</header>
