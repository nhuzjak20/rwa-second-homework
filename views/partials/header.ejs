<header>
  <h1>RWA — Demo sigurnosnih ranjivosti</h1>
  <p>SQL umetanje i loša autentifikacija, svaka s prekidačem RANJIVO / SIGURNO.</p>

  <div class="toggles">
    <%
      const switches = [
        { name: 'sqli', label: 'SQL umetanje', on: flags.sqliVulnerable },
        { name: 'csrf', label: 'CSRF', on: flags.csrfVulnerable },
      ];
    %>
    <% switches.forEach(function (s) { %>
      <form class="toggle" method="POST" action="/">
        <input type="hidden" name="action" value="toggle">
        <input type="hidden" name="name" value="<%= s.name %>">
        <input type="checkbox" onchange="this.form.submit()" <%= s.on ? 'checked' : '' %>>
        <span class="toggle-label"><%= s.label %></span>
        <span class="badge">[<%= s.on ? 'RANJIVO' : 'SIGURNO' %>]</span>
      </form>
    <% }); %>
  </div>
</header>
